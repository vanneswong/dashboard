# ============================================================================
# 服务仪表盘配置文件 (TOML格式)
# ============================================================================
# 使用TOML格式配置服务，更加易读和维护
# 每个服务使用 [[services]] 表示
# ============================================================================

# 全局配置（可选）
[global]
# 排除的端口列表（不显示在仪表盘上）
exclude_ports = [22000]

# ============================================================================
# 服务配置示例
# ============================================================================

# 示例1: Web服务（简化配置）
# 只需配置端口和标题，其他字段自动检测
# [[services]]
# port = 80
# name = "主网站"
# desc = "公司官网，提供产品展示和联系方式"

# 示例2: 完整配置
# 可以手动指定访问权限和颜色
# [[services]]
# port = 443
# name = "服务仪表盘"
# desc = "服务监控面板，展示本机部署的所有服务"
# access = "local"           # 访问权限: global(公网) 或 local(局域网)，不填则自动检测
# color = "auto"             # 卡片颜色: auto 或 CSS渐变/十六进制颜色
# btn_color = "auto"         # 按钮颜色: auto 或 十六进制颜色

# ============================================================================
# 常用服务示例（取消注释即可使用）
# ============================================================================

# Web服务
# [[services]]
# port = 80
# name = "主网站"
# desc = "公司官网"

# 管理后台
# [[services]]
# port = 8080
# name = "管理后台"
# desc = "系统管理后台"

# 监控工具
# [[services]]
# port = 3000
# name = "Grafana"
# desc = "监控可视化平台"

# 容器管理
# [[services]]
# port = 9000
# name = "Portainer"
# desc = "Docker容器管理平台"

# 数据库
# [[services]]
# port = 3306
# name = "MySQL"
# desc = "MySQL数据库服务"
# access = "local"

# 网页终端
# [[services]]
# port = 7681
# name = "网页终端"
# desc = "基于Web的SSH终端客户端"

# 下载工具
# [[services]]
# port = 8080
# name = "qBittorrent"
# desc = "BT下载客户端"

# ============================================================================
# 颜色配置示例
# ============================================================================

# 自定义颜色（使用CSS渐变）
# [[services]]
# port = 8080
# name = "自定义服务"
# desc = "使用自定义颜色的服务"
# color = "linear-gradient(135deg, #3498db 0%, #2980b9 100%)"
# btn_color = "#3498db"

# 自定义颜色（使用十六进制）
# [[services]]
# port = 9000
# name = "另一个服务"
# desc = "使用十六进制颜色的服务"
# color = "linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%)"
# btn_color = "#9b59b6"
