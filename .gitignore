# ============================================================================
# Git忽略文件
# ============================================================================

# 本机配置文件（不上传到Git）
conf/services.conf

# 日志文件
*.log

# 备份文件
*.backup
*.bak
*.swp
*.swo
*~

# 临时文件
/tmp/

# 系统文件
.DS_Store
Thumbs.db

# 编辑器文件
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 运行时生成的文件
/var/www/dashboard/

# Nginx配置（运行时生成）
/etc/nginx/
